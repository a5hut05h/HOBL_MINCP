<?xml version='1.0' encoding='utf-8' standalone='yes'?>
<WindowsPerformanceRecorder
    Author="EcoSystem Performance Platform"
    Comments="Sample"
    Company="Microsoft Corporation"
    Copyright="Microsoft Corporation"
    Team="EcoSystem Performance Platform"
    Version="1.0"
    >
  <Profiles>
    <SystemCollector
        Id="SystemCollector"
        Name="NT Kernel Logger"
        >
      <!-- 1MB * 100 buffers = 100 MB -->
      <BufferSize Value="1024"/> 
		<Buffers Value="3" PercentageOfTotalMemory="true" MaximumBufferSpace="100"/>
		<StackCaching BucketCount="256" CacheSize="3072"/>
    </SystemCollector>

    <EventCollector
        Id="EventCollector_UserMode"
        Name="WPR Sample Event Collector"
        >
      <!-- 1MB * 95 buffers = 95 MB -->
		<BufferSize Value="256"/>
		<Buffers Value="3" PercentageOfTotalMemory="true" MaximumBufferSpace="100"/>
    </EventCollector>

    <EventCollector
      Id="EventCollector_UserMode_DXStacks"
      Name="WPR Sample Event Collector DXStacks"
        >
      <!-- 1MB * 5 buffers = 5 MB -->
      <BufferSize Value="1024"/>
	  <Buffers Value="5" PercentageOfTotalMemory="true" MaximumBufferSpace="256"/>
    </EventCollector>
    
    <SystemProvider Id="SystemProvider">
      <Keywords>
        <!-- Disk -->
        <Keyword Value="DiskIO"/>
        <Keyword Value="HardFaults"/>
        
        <!-- CPU -->
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="Power"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
        <Keyword Value="SampledProfile"/>
        <Keyword Value="DPC"/>
        <Keyword Value="WDFDPC"/>
        <Keyword Value="Interrupt"/>
        <Keyword Value="WDFInterrupt"/>
        <Keyword Value="IdleStates"/>
        <Keyword Value="InterProcessorInterrupt"/>

        <!-- Memory -->
        <Keyword Value="Memory"/>
        <Keyword Value="MemoryInfo"/>
        <Keyword Value="MemoryInfoWS"/>
      </Keywords>
      <Stacks>
        <Stack Value="CSwitch"/>
        <Stack Value="ReadyThread"/>
        <Stack Value="SampledProfile"/>
      </Stacks>
    </SystemProvider>
    
    <HardwareCounter Id="HardwareCounter_InstructionCounter" Strict="false">
      <Counters>
        <Counter Value="TotalCycles" />
        <Counter Value="InstructionRetired" />
      </Counters>
      <Events>
        <Event Value="CSwitch" />
        <Event Value="SampledProfile" />
      </Events>
    </HardwareCounter>
    
    <!-- Power -->
    <EventProvider
        Id="EventProvider_Microsoft-Windows-Kernel-Power"
        Name="Microsoft-Windows-Kernel-Power"
        NonPagedMemory="true"
        Level="6"
        >
      <Keywords>
        <Keyword Value="0xFFFFFFFB"/>
      </Keywords>
      <CaptureStateOnSave>
        <Keyword Value="0xFFFFFFFF"/>
      </CaptureStateOnSave>
    </EventProvider>

    <!-- Memory -->
    <EventProvider
        Id="EventProvider_Microsoft-Windows-Kernel-Memory"
        Name="d1d93ef7-e1f2-4f45-9943-03d245fe6c00"
        NonPagedMemory="true"
        Level="0"
        EventKey="true"
        >
      <Keywords>
        <Keyword Value="0xFFFFFFFFFFFFFFFF"/>
      </Keywords>
    </EventProvider>

    <EventProvider
       Id="EventProvider_Microsoft-Windows-Kernel-Processor-Power"
       Name="Microsoft-Windows-Kernel-Processor-Power"
       NonPagedMemory="true"
       Level="6"
        >
      <Keywords>
        <Keyword Value="0xFFFFFFFF"/>
      </Keywords>
      <CaptureStateOnSave>
        <Keyword Value="0xFFFFFFFF"/>
      </CaptureStateOnSave>
    </EventProvider>
   
