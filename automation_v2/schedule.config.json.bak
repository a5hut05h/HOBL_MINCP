{
    "_comment":  "HOBL automation v2 schedule. Each job points at a HOBL testplan .ps1 file (the same file lab developers run locally with hobl.cmd). daily_run.ps1 parses that testplan and POSTs it to HOBLweb\u0027s /plan/Create as a brand-new plan with AutoResubmit set so it cycles \u0027runsPerDay\u0027 times. There is no template plan in HOBLweb\u0027s DB — the .ps1 in git is the source of truth.",
    "hoblwebBaseUrl":  "http://localhost",
    "logDir":  "",
    "logRetentionDays":  30,
    "overlap":  "skip",
    "submit":  {
                   "timeoutSec":  30,
                   "maxAttempts":  5,
                   "backoffSec":  [
                                      5,
                                      15,
                                      60,
                                      180,
                                      600
                                  ]
               },
    "monitor":  {
                    "_comment":  "After submitting, daily_run.ps1 stays attached and polls HOBLweb every \u0027intervalSec\u0027 seconds, logging the current PlanID / cycle / scenario / status until the AutoResubmit chain finishes or \u0027maxHours\u0027 elapses. Set \u0027enabled\u0027 to false to revert to fire-and-forget.",
                    "enabled":  true,
                    "intervalSec":  45,
                    "maxHours":  24
                },
    "jobs":  [
                 {
                     "name":  "LEN-WCL-FUN-IDL-01_teams",
                     "enabled":  true,
                     "profile":  "LEN-WCL-FUN-IDL-01",
                     "testplan":  "testplans/teams.ps1",
                     "runsPerDay":  2
                 },
                 {
                     "name":  "ITL-PTL-PUE-IDL-02_teams_desktop",
                     "enabled":  true,
                     "profile":  "ITL-PTL-PUE-IDL-02",
                     "testplan":  "testplans/teams_desktop.ps1",
                     "runsPerDay":  1
                 }
             ],
    "email":  {
                  "enabled":  true,
                  "to":  "n"
              },
    "schedule":  {
                     "frequency":  "Daily",
                     "time":  "08:21",
                     "dayOfWeek":  "Thursday",
                     "dayOfMonth":  2
                 }
}
