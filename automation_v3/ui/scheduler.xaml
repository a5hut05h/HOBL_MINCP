<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOBL Automation V3 Scheduler" Width="1280" Height="820"
        MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F5F7FA" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0067B8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#17202A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5F6B78"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,3"/><Setter Property="BorderBrush" Value="#C7D0D9"/><Setter Property="Background" Value="White"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="#C7D0D9"/><Setter Property="Background" Value="White"/></Style>
        <Style TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,4"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#B8C2CC"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <Style x:Key="Section" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E0E5EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="14"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E5EA" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="HOBL Automation V3 Scheduler" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Configure independent DUT workers and one combined daily report." Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/></StackPanel>
                <Border x:Name="ModeBadge" Grid.Column="1" Background="#FFF2CC" CornerRadius="4" Padding="14,7" VerticalAlignment="Center"><TextBlock x:Name="ModeText" Text="PREVIEW MODE" Foreground="#6B5000" FontWeight="SemiBold"/></Border>
            </Grid>
        </Border>
        <Border x:Name="ExistingTaskBanner" DockPanel.Dock="Top" Background="#FFF7D6" BorderBrush="#E6C95C" BorderThickness="0,0,0,1" Padding="28,12" Visibility="Collapsed">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="V3 scheduled tasks detected" FontWeight="SemiBold"/><TextBlock x:Name="ExistingTaskText" Foreground="#5F531F" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0"><Button x:Name="TopRunButton" Content="Run selected" Width="125" Margin="0,0,10,0"/><Button x:Name="TopDeleteButton" Content="Delete selected" Width="175"/></StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E5EA" BorderThickness="0,1,0,0" Padding="20,9">
            <Grid><TextBlock x:Name="FooterStatus" Text="Review settings before registration." Foreground="{StaticResource TextSecondary}"/><Button x:Name="SaveButton" Content="Save and register independent tasks" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="310"/></Grid>
        </Border>
        <Grid Margin="20,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Section}">
                    <StackPanel><TextBlock Text="Common schedule" Style="{StaticResource SectionTitle}"/>
                        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Frequency" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FrequencyCombo"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Start time" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="HourCombo" Width="78"/><TextBlock Text=":" Margin="10,0"/><ComboBox x:Name="MinuteCombo" Width="78"/></StackPanel></StackPanel>
                            <StackPanel x:Name="WeekdayPanel" Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Text="Day of week" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WeekdayCombo"/></StackPanel>
                            <StackPanel x:Name="MonthDayPanel" Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Text="Day of month" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MonthDayCombo"/></StackPanel>
                            <StackPanel x:Name="OnceDatePanel" Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Text="Run date" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="OnceDatePicker" Height="34"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Section}">
                    <StackPanel><TextBlock Text="Combined report email" Style="{StaticResource SectionTitle}"/><TextBlock Text="Send one report after expected DUTs finish?" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><RadioButton x:Name="EmailYesRadio" Content="Yes" IsChecked="True" Margin="0,0,24,0"/><RadioButton x:Name="EmailNoRadio" Content="No"/></StackPanel>
                        <StackPanel x:Name="RecipientPanel"><TextBlock Text="Send to" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RecipientText"/><TextBlock Text="Send date and time" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="EmailDatePicker" Width="190" Height="34"/><ComboBox x:Name="EmailHourCombo" Width="72" Margin="10,0,0,0"/><TextBlock Text=":" Margin="7,0"/><ComboBox x:Name="EmailMinuteCombo" Width="72"/></StackPanel><TextBlock Text="One combined snapshot is sent at this local date and time. Separate recipients with semicolons." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Section}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Required DUT list" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><TextBlock Text="Check an available DUT to add it. Configured DUTs are shaded and cannot be scheduled twice." Foreground="{StaticResource TextSecondary}" FontSize="12"/></StackPanel>
                            <TextBlock Grid.Column="1" Text="Delete an existing configuration before replacing its scenario set." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Bottom"/>
                        </Grid>
                        <DataGrid x:Name="DutGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#D6DDE4" RowHeight="30" ColumnHeaderHeight="32" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsExisting}" Value="True"><Setter Property="Background" Value="#E8EBEF"/><Setter Property="Foreground" Value="#5F6B78"/></DataTrigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CFE8FF"/><Setter Property="Foreground" Value="#17324D"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Add" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdd}" IsHitTestVisible="{Binding CanAdd}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="DUT profile" Width="*" Binding="{Binding Profile}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Width="190" Binding="{Binding Status}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="HOBL scenarios" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding PlanHobl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" IsHitTestVisible="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MinCP scenarios" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding PlanMincp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" IsHitTestVisible="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MinCP New Outlook" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding PlanMincpNewOutlook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" IsHitTestVisible="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ETL trace scenarios" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding PlanEtlTrace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" IsHitTestVisible="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Runs" Width="75" Binding="{Binding Runs}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Section}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="150"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Selected DUT task" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBox x:Name="TaskStatusText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" Height="150"/>
                        <UniformGrid Grid.Row="4" Rows="3" Columns="2"><Button x:Name="RefreshButton" Content="Refresh details" Margin="0,0,8,8"/><Button x:Name="RunButton" Content="Run selected" Margin="0,0,0,8"/><Button x:Name="ToggleButton" Content="Pause / Resume" Margin="0,0,8,8"/><Button x:Name="DeleteButton" Content="Delete selected" Margin="0,0,0,8"/><Button x:Name="LogsButton" Content="Open selected logs" Margin="0,0,8,0"/><Button x:Name="DeleteAllButton" Content="Delete all"/></UniformGrid>
                    </Grid>
                </Border>
        </Grid>
    </DockPanel>
</Window>
